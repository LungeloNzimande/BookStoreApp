@page "/"
@using BlazingSampleApp.Services
@inject ISampleApiClient SampleApiClient

<PageTitle>Activities</PageTitle>

<h1>Activities</h1>

<hr />

@* <Virtualize Items="activities" Context="activity" ItemSize="5">
    <p>@activity.Title</p>
</Virtualize> *@

<div style="height:50px; overflow-y:scroll" tabindex="-1">
    <Virtualize Items="activities" Context="activity" ItemSize="5">
        <div class="flight-info">Flight @activity.Id</div>
    </Virtualize>
</div>

@code {
    private List<Activity> activities = new();
    private const int MaxItems = 10; // Limit the number of items

    protected override async Task OnInitializedAsync()
    {
        activities = (await SampleApiClient.ActivitiesAllAsync())
            .ToList();
    }
}
@page "/"
@using BlazingSampleApp.Services
@using Blazored.Modal.Services
@inject ISampleApiClient SampleApiClient
@inject IToastService toastService

<PageTitle>Activities</PageTitle>

<h1>Activities</h1>
<button class="btn btn-info" @onclick="@(() => toastService.ShowInfo("I'm an INFO message"))">Info Toast</button>

<button @onclick="@(() => Modal.Show<Index>("My Movies"))">View Movies</button>
<hr />

@* <Virtualize Items="activities" Context="activity" ItemSize="5">
    <p>@activity.Title</p>
</Virtualize> *@

<div style="height:50px; overflow-y:scroll" tabindex="-1">
    <Virtualize Items="activities" Context="activity" ItemSize="5">
        <div class="flight-info">Flight @activity.Id</div>
    </Virtualize>
</div>

@code {
    private List<Product> activities = new();
    private const int MaxItems = 10; // Limit the number of items

    [CascadingParameter] public IModalService Modal { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        activities = (await SampleApiClient.GetAllProductsAsync())
            .ToList();
    }
}